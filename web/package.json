{
	"name": "postframe-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "wrangler types --check && vite build",
		"build:desktop": "POSTFRAME_TARGET=desktop vite build",
		"desktop": "cd .. && web/node_modules/.bin/tauri",
		"desktop:dev": "cd .. && web/node_modules/.bin/tauri dev",
		"desktop:build": "cd .. && web/node_modules/.bin/tauri build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"preview:host": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --ip 0.0.0.0",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test tests/*.test.ts",
		"test:e2e": "playwright test",
		"lint": "oxlint . --deny-warnings",
		"lint:fix": "oxlint . --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@lucide/svelte": "^0.575.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2",
		"@types/node": "^26.1.2",
		"bits-ui": "^2.18.1",
		"fake-indexeddb": "^6.2.5",
		"fast-check": "^4.9.0",
		"layerchart": "^2.0.4",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"@huggingface/transformers": "4.2.0",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"dexie": "^4.4.4",
		"exifr": "^7.1.3",
		"openseadragon": "^6.0.2",
		"tinykeys": "^4.0.0",
		"wasm-feature-detect": "^1.8.0",
		"zod": "^4.4.3"
	}
}
